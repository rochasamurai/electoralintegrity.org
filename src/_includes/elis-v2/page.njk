<!doctype html>
<html lang="{{ l.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#12243b">
<meta name="description" content="{{ l.intro }}">
<title>ELIS — {{ l.headline }}</title>
<link rel="canonical" href="https://electoralintegrity.org/{{ l.code }}/">
<link rel="alternate" hreflang="en-GB" href="https://electoralintegrity.org/en/">
<link rel="alternate" hreflang="pt-BR" href="https://electoralintegrity.org/pt/">
<link rel="alternate" hreflang="x-default" href="https://electoralintegrity.org/en/">
<meta property="og:type" content="website">
<meta property="og:title" content="ELIS — {{ l.headline }}">
<meta property="og:description" content="{{ l.intro }}">
<meta property="og:url" content="https://electoralintegrity.org/{{ l.code }}/">
<style>
:root{--ink:#15273e;--navy:#12243b;--teal:#286a83;--gold:#e8c777;--muted:#53647a;--line:#dce4eb;--bg:#f3f6f9;--white:#fff;color-scheme:light}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:5rem}
body{margin:0;font:400 1rem/1.65 system-ui,-apple-system,"Segoe UI",Arial,sans-serif;color:var(--ink);background:var(--bg);overflow-wrap:break-word}
a{color:#165a78;text-underline-offset:3px}a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid #efb342;outline-offset:3px}
img,svg{max-width:100%;height:auto}button,a,summary{touch-action:manipulation}
.skip{position:absolute;left:1rem;top:-8rem;z-index:20;background:#fff;color:#15273e;padding:.8rem}.skip:focus{top:1rem}
.wrap{width:min(1140px,calc(100% - 2.5rem));margin-inline:auto}
.header{background:#112238;color:#fff;position:relative;z-index:10}
.headbar{display:flex;align-items:center;justify-content:space-between;gap:1.25rem;min-height:5rem}
.brand{display:inline-flex;flex-direction:column;line-height:1.1;color:#fff;text-decoration:none;font-size:1.65rem;font-weight:850;letter-spacing:.06em;flex-shrink:0}
.brand small{font-size:.58rem;color:#bfd1dc;letter-spacing:.12em;font-weight:500;margin-top:.35rem}
.menu{margin-left:auto}.menu summary{display:none;cursor:pointer;min-height:44px;align-items:center;padding:.6rem;border:1px solid #71849a;border-radius:8px;list-style:none}
.menu summary::-webkit-details-marker{display:none}.navlinks{display:flex;align-items:center;flex-wrap:wrap;justify-content:flex-end;gap:.75rem 1.15rem}
.navlinks a{color:#f4f8fa;font-weight:600;text-decoration:none;font-size:.87rem}.navlinks a:hover,.navlinks a:focus-visible{text-decoration:underline}
.language{padding:.4rem .65rem;border:1px solid #71849a;border-radius:6px;white-space:nowrap}
.language [aria-current]{color:var(--gold);font-weight:800}
.hero{background:radial-gradient(circle at 87% 15%,#2a5970 0%,transparent 35%),linear-gradient(135deg,#13253e,#203f53);color:white;padding:clamp(3rem,7vw,6rem) 0}
.eyebrow{color:var(--gold);font-size:.78rem;letter-spacing:.11em;font-weight:750}
h1,h2{font-family:Georgia,"Times New Roman",serif;line-height:1.18}h1{font-size:clamp(2.15rem,5vw,4.5rem);max-width:840px;margin:1rem 0}h2{font-size:clamp(1.75rem,3.4vw,2.65rem);margin:0 0 1rem}
.hero p{max-width:830px;color:#e0eaf0;font-size:clamp(1rem,1.6vw,1.18rem)}
.actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1.7rem}
.button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:.7rem 1.2rem;border-radius:8px;text-decoration:none;font-weight:750}
.button.primary{background:var(--gold);color:#17263a}.button.secondary{color:#fff;border:1px solid #b4c9d6}
.section{padding:clamp(2.8rem,5vw,4.5rem) 0;scroll-margin-top:1rem}
.section:nth-of-type(even){background:#fff}.lead{max-width:850px;color:var(--muted);margin:-.3rem 0 1.5rem}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}
.card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:clamp(1.05rem,2.2vw,1.6rem);min-width:0}
.section:nth-of-type(even) .card{background:#f7f9fb}
.card h3{font-size:1.17rem;line-height:1.3;margin:.35rem 0 .5rem}.card p{margin:0 0 1rem;color:#45576b}.card p:last-child{margin-bottom:0}
.card .more{font-size:.92rem;font-weight:700}.tag{display:inline-block;border-radius:99px;background:#e3eff3;color:#22566d;padding:.24rem .67rem;font-size:.75rem;font-weight:750}
.resources{list-style:none;padding:0;display:grid;gap:1rem}.resources li{padding:1.1rem 1.25rem;background:#f6f9fb;border:1px solid var(--line);border-radius:12px}
.resources li p{margin:.3rem 0 0;color:var(--muted)}
.callout{border-left:4px solid var(--gold);padding:1rem 1.35rem;background:#fff8e9;border-radius:0 10px 10px 0}
.footer{background:#112238;color:#dce8f0;padding:2.4rem 0}.footer a{color:#f0f5fa}.footer small{display:block;color:#c4d2dd;margin-top:1rem}
.notice{font-size:.91rem;color:var(--muted);max-width:930px}
@media(max-width:960px){.menu summary{display:flex}.menu:not([open]) .navlinks{display:none}.menu[open] .navlinks{display:flex;position:absolute;left:0;right:0;top:100%;background:#112238;padding:1rem max(1.25rem,calc((100vw - 1140px)/2));box-shadow:0 12px 22px #0a172633;flex-direction:column;align-items:stretch;gap:0}.menu[open] .navlinks a{min-height:44px;display:flex;align-items:center;border-bottom:1px solid #30465c}.language{align-self:flex-start;margin-top:.8rem}}
@media(max-width:700px){.wrap{width:calc(100% - 2rem)}.grid,.grid.three{grid-template-columns:1fr}.hero{padding:2.9rem 0}.section{padding:2.5rem 0}.headbar{min-height:4.25rem}.brand{font-size:1.4rem}}
@media(min-width:701px) and (max-width:950px){.grid.three{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(orientation:landscape) and (max-height:500px){.hero{padding:1.8rem 0}.hero h1{font-size:clamp(1.8rem,4vw,2.7rem);margin:.6rem 0}.headbar{min-height:3.5rem}.section{padding:1.8rem 0}.menu[open] .navlinks{max-height:calc(100dvh - 3.5rem);overflow:auto;overscroll-behavior:contain}}
@media(max-width:360px){.brand small{font-size:.48rem}.actions .button{width:100%}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
@media print{.header,.actions{display:none}.hero{color:#15273e;background:white;padding:1rem 0}.hero p{color:#15273e}.section{padding:1.5rem 0}.card{break-inside:avoid}}
</style>
</head>
<body>
<a class="skip" href="#main">{{ l.skip }}</a>
<header class="header">
  <div class="wrap headbar">
    <a class="brand" href="/{{ l.code }}/" aria-label="ELIS — Electoral Integrity Strategies">ELIS<small>ELECTORAL INTEGRITY STRATEGIES</small></a>
    <details class="menu"><summary aria-label="{{ l.menu }}">{{ l.menu }} ☰</summary>
      <nav class="navlinks" aria-label="{{ l.menu }}">
        <a href="#main">{{ l.home }}</a>
        <a href="#research">{{ l.research }}</a>
        <a href="#technology">{{ l.technology }}</a>
        <a href="#publications">{{ l.publications }}</a>
        <a href="#partnerships">{{ l.partnerships }}</a>
        <a href="#about">{{ l.about }}</a>
        <a href="#contact">{{ l.contact }}</a>
        <span class="language" aria-label="Language / Idioma"><span aria-current="true">{{ l.code | upper }}</span> · <a href="{{ l.otherPath }}" lang="{{ l.other }}">{{ l.otherLabel }}</a></span>
      </nav>
    </details>
  </div>
</header>
<main id="main">
<section class="hero" aria-labelledby="hero-title"><div class="wrap">
  <div class="eyebrow">{{ l.eyebrow }}</div><h1 id="hero-title">{{ l.headline }}</h1>
  <p>{{ l.intro }}</p>
  <div class="actions"><a class="button primary" href="#research">{{ l.heroPrimary }}</a><a class="button secondary" href="#partnerships">{{ l.heroSecondary }}</a></div>
</div></section>
<section class="section" id="technology"><div class="wrap">
  <h2>{{ l.areasTitle }}</h2><p class="lead">{{ l.areasIntro }}</p>
  <div class="grid">{% for area in l.areas %}<article class="card"><h3>{{ area.title }}</h3><p>{{ area.description }}</p></article>{% endfor %}</div>
</div></section>
<section class="section" id="research"><div class="wrap">
  <h2>{{ l.projectsTitle }}</h2><p class="lead">{{ l.projectsIntro }}</p>
  <div class="grid">{% for project in l.projects %}
    <article class="card" id="project-{{ project.id }}">
      <span class="tag">{{ l.labels[project.tag] }}</span><h3>{{ project.title }}</h3>
      <p>{{ project.description }}</p>
      <p><strong>{% if l.code == 'pt' %}Oportunidade de colaboração:{% else %}Collaboration opportunity:{% endif %}</strong> {{ project.need }}</p>
      {% if project.url %}<a class="more" href="{{ project.url }}" target="_blank" rel="noopener noreferrer">{{ project.urlLabel }} ↗</a>{% endif %}
    </article>
  {% endfor %}</div>
</div></section>
<section class="section" id="publications"><div class="wrap">
  <h2>{{ l.publicationsTitle }}</h2><p class="lead">{{ l.publicationsIntro }}</p>
  <ul class="resources">{% for item in l.resources %}<li><a href="{{ item.url }}" target="_blank" rel="noopener noreferrer"><strong>{{ item.title }}</strong></a><p>{{ item.description }}</p></li>{% endfor %}</ul>
</div></section>
<section class="section" id="partnerships"><div class="wrap">
  <h2>{{ l.opportunitiesTitle }}</h2><p class="lead">{{ l.opportunitiesIntro }}</p>
  <div class="grid">{% for opp in l.opportunities %}<article class="card"><h3>{{ opp.title }}</h3><p>{{ opp.description }}</p></article>{% endfor %}</div>
</div></section>
<section class="section" id="about"><div class="wrap">
  <h2>{{ l.aboutTitle }}</h2><p class="lead">{{ l.aboutText }}</p>
  <div class="grid">{% for item in l.methodology %}<article class="card"><h3>{{ item.title }}</h3><p>{{ item.description }}</p></article>{% endfor %}</div>
  <p class="notice">{{ l.affiliation }}</p>
</div></section>
<section class="section" id="contact"><div class="wrap">
  <h2>{{ l.contactTitle }}</h2><p class="lead">{{ l.contactText }}</p>
  <p><a class="button primary" href="mailto:contact@electoralintegrity.org?subject=ELIS%20Research%20Partnership">{{ l.emailLabel }}</a></p>
  <p class="notice">{{ l.privacyText }}</p>
  <p class="callout">{{ l.disclaimer }}</p>
</div></section>
</main>
<footer class="footer"><div class="wrap"><strong>ELIS — Electoral Integrity Strategies</strong>
  <p>{{ l.footer }}</p><a href="/{{ l.code }}/">{{ l.home }}</a> · <a href="/privacy/">{{ l.privacy }}</a> · <a href="mailto:contact@electoralintegrity.org">contact@electoralintegrity.org</a>
  <small>{{ l.lastUpdated }} · {{ l.legal }}</small>
</div></footer>
</body></html>
