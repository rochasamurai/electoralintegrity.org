---
permalink: /site.webmanifest
eleventyExcludeFromCollections: true
excludeFromSitemap: true
---
{
  "name": "{{ meta.siteName }}",
  "short_name": "ELIS",
  "description": "{{ meta.siteDescription }}",
  "start_url": "/",
  "scope": "/",
  "icons": [
    {
      "src": "/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/maskable-icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "theme_color": "{{ meta.themeColor }}",
  "background_color": "{{ meta.themeDark }}",
  "display": "standalone",
  "orientation": "portrait-primary",
  "lang": "{{ meta.lang }}",
  "dir": "ltr",
  "categories": ["education", "research", "politics"]
}
